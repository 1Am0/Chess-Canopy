/**
 * Generates app/paper-textures.css: the static desk (kraft board) and sheet (cream paper)
 * fibre tiles as data-URI SVGs, light and dark. Fibres come from lib/paper.ts with fixed
 * seeds, so the output is identical on every run.
 *
 *   node scripts/gen-paper-textures.mts
 */
import { writeFileSync } from "node:fs";
import { fibreStrands, svgDataUri } from "../lib/paper.ts";

type Tone = { grain: [number, number, number, number]; mottle: [number, number, number, number]; light: string; lightOp: number; dark: string; darkOp: number };

function strands(seed: string, size: number, count: number, stroke: string, opacity: number, width: number, min: number, max: number) {
  const d = fibreStrands(seed, size, size, count, { min, max, margin: 4 }).join("");
  return `<path d='${d}' fill='none' stroke='${stroke}' stroke-opacity='${opacity}' stroke-width='${width}' stroke-linecap='round'/>`;
}

function filter(id: string, freq: number, octaves: number, seed: number, c: [number, number, number, number]) {
  return (
    `<filter id='${id}' x='0' y='0' width='100%' height='100%'>` +
    `<feTurbulence type='fractalNoise' baseFrequency='${freq}' numOctaves='${octaves}' seed='${seed}' stitchTiles='stitch'/>` +
    `<feColorMatrix values='0 0 0 0 ${c[0]} 0 0 0 0 ${c[1]} 0 0 0 0 ${c[2]} 0 0 0 ${c[3]} 0'/></filter>`
  );
}

function desk(size: number, t: Tone, name: string) {
  const svg =
    `<svg xmlns='http://www.w3.org/2000/svg' width='${size}' height='${size}'>` +
    filter("g", 0.85, 2, 3, t.grain) +
    filter("m", 0.011, 3, 8, t.mottle) +
    `<rect width='100%' height='100%' filter='url(#m)'/>` +
    `<rect width='100%' height='100%' filter='url(#g)'/>` +
    strands(`${name}-light`, size, 34, t.light, t.lightOp, 0.7, 9, 38) +
    strands(`${name}-dark`, size, 44, t.dark, t.darkOp, 0.6, 7, 30) +
    `</svg>`;
  return svgDataUri(svg);
}

function sheet(size: number, t: Tone, name: string) {
  const svg =
    `<svg xmlns='http://www.w3.org/2000/svg' width='${size}' height='${size}'>` +
    filter("g", 0.9, 2, 5, t.grain) +
    `<rect width='100%' height='100%' filter='url(#g)'/>` +
    strands(`${name}-light`, size, 18, t.light, t.lightOp, 0.5, 8, 26) +
    strands(`${name}-dark`, size, 24, t.dark, t.darkOp, 0.45, 6, 22) +
    `</svg>`;
  return svgDataUri(svg);
}

const deskLight = desk(360, { grain: [0.3, 0.2, 0.09, 0.2], mottle: [0.5, 0.34, 0.16, 0.2], light: "#fbf0d4", lightOp: 0.38, dark: "#6a4a22", darkOp: 0.26 }, "desk-l");
const deskDark = desk(360, { grain: [0.85, 0.65, 0.4, 0.09], mottle: [0, 0, 0, 0.3], light: "#d9b988", lightOp: 0.075, dark: "#000000", darkOp: 0.32 }, "desk-d");
const sheetLight = sheet(280, { grain: [0.4, 0.3, 0.15, 0.05], mottle: [0, 0, 0, 0], light: "#ffffff", lightOp: 0.5, dark: "#9a7d4c", darkOp: 0.16 }, "sheet-l");
const sheetDark = sheet(280, { grain: [0.95, 0.88, 0.72, 0.035], mottle: [0, 0, 0, 0], light: "#f3e6c8", lightOp: 0.07, dark: "#000000", darkOp: 0.2 }, "sheet-d");

const css = `/* Generated by scripts/gen-paper-textures.mts: do not edit by hand. Static tiles, never animated. */
:root {
  --desk-tile: url("${deskLight}");
  --sheet-tile: url("${sheetLight}");
}
.dark {
  --desk-tile: url("${deskDark}");
  --sheet-tile: url("${sheetDark}");
}
`;
writeFileSync(new URL("../app/paper-textures.css", import.meta.url), css);
console.log(`paper-textures.css: ${(css.length / 1024).toFixed(1)} KB`);
